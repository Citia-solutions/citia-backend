# Todas las variables se validan al arrancar (src/shared/infrastructure/config/entorno.ts):
# si alguna falta o esta mal, la app no arranca y lista todos los errores juntos.
# Fuera de produccion todo tiene default salvo JWT_SECRET; un valor vacio (VAR=)
# cuenta como no definido.

# Entorno: development | production | test. Default development (jest usa test).
# En production no hay defaults para DB_* ni FRONTEND_URL.
# NODE_ENV=development

PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=citia_dev

# Autenticacion JWT
#   JWT_SECRET: clave para firmar/verificar los tokens.
#   EN PRODUCCION debe inyectarse por el entorno (compose/secretos), NUNCA hardcodeada,
#   y tener al menos 32 caracteres (el arranque rechaza este valor de ejemplo).
JWT_SECRET=dev-only-change-me-super-secret
#   JWT_EXPIRES_IN: tiempo de vida del token (formato de 'ms'/jsonwebtoken). Default 1d.
JWT_EXPIRES_IN=1d

# CORS (credentials habilitado)
#   FRONTEND_URL: origen canonico del frontend (esquema://host[:puerto], sin ruta).
#   Obligatorio en produccion. Default fuera de produccion: http://localhost:5173.
FRONTEND_URL=http://localhost:5173
#   CORS_ORIGENES_EXTRA: otros origenes permitidos, separados por comas. Admite
#   origenes exactos y un unico comodin, el de las vistas previas de Cloudflare
#   Pages: https://*.<proyecto>.pages.dev (un solo nivel de subdominio, solo https).
#   https://*.pages.dev a secas NO se acepta. Default: ninguno.
# CORS_ORIGENES_EXTRA=https://*.citia-frontend.pages.dev,http://localhost:3002

# Zona horaria de la clinica. El "dia" y la "hora" del dashboard de citas se
# calculan en esta zona (el contenedor corre en UTC). Default: America/Santiago.
APP_TZ=America/Santiago

# Test database (solo para integration tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASS=postgres
TEST_DB_NAME=citia_test

# Ventana (en horas) de la regla "una solicitud de hora abierta a la vez" por RUT.
# Pasado el plazo, el paciente puede volver a pedir aunque su solicitud siga sin
# revisar. Evita que una bandeja desatendida lo bloquee de por vida (DT-28).
SOLICITUD_VENTANA_HORAS=72

# Logs (pino, ADR-13 §16). Correo, RUT, telefono, credenciales y cuerpos se redactan.
#   LOG_NIVEL: fatal | error | warn | info | debug | trace | silent.
#   Default info (silent con NODE_ENV=test).
# LOG_NIVEL=info
#   LOG_FORMATO: json | pretty. Default pretty en development, json en el resto.
#   pretty necesita pino-pretty (devDependency): en la imagen de produccion cae a json.
# LOG_FORMATO=pretty

# Better Stack (observabilidad, ADR-13 §16). Todo opcional: sin valores, nada cambia.
#   BETTERSTACK_SOURCE_TOKEN: token de la fuente de logs. Si existe, los logs van
#   tambien a Better Stack (ademas de la salida estandar). Secreto.
# BETTERSTACK_SOURCE_TOKEN=
#   BETTERSTACK_INGESTING_HOST: host de ingesta que muestra la fuente en Better Stack
#   (p. ej. s1234567.eu-nbg-2.betterstackdata.com). Sin el, se usa el de la libreria.
# BETTERSTACK_INGESTING_HOST=
#   Latidos (heartbeats) de los jobs: URL completa del heartbeat, https. Llevan el
#   token del heartbeat: tratarlas como secretos. Sin URL, el latido no se envia.
# BETTERSTACK_HEARTBEAT_SALIDA_URL=https://uptime.betterstack.com/api/v1/heartbeat/<token>
# BETTERSTACK_HEARTBEAT_RECORDATORIOS_URL=https://uptime.betterstack.com/api/v1/heartbeat/<token>

# Planificador y outbox eventos_salida (ADR-12 §3 y §5)
#   PLANIFICADOR_ACTIVO: si false, ningun job corre. Default true (false con NODE_ENV=test).
# PLANIFICADOR_ACTIVO=true
#   Despachador de salida: cada cuantos segundos corre, hechos por tick, intentos
#   antes de pasar a fallido, y dias que se guardan los entregados.
# EVENTOS_SALIDA_INTERVALO_SEG=5
# EVENTOS_SALIDA_LOTE=50
# EVENTOS_SALIDA_MAX_INTENTOS=10
# EVENTOS_SALIDA_RETENCION_DIAS=14

# Mensajeria (ADR-13 §8, §13)
#   MENSAJERIA_ADAPTADOR: registro (no envia nada; default) | resend.
# MENSAJERIA_ADAPTADOR=registro
#   Obligatorias solo con MENSAJERIA_ADAPTADOR=resend. Secretos.
#   RESEND_WEBHOOK_SECRET es el secreto de firma del webhook (empieza con whsec_).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
#   CORREO_DOMINIO: subdominio de envio verificado en Resend (el dominio aun no esta comprado).
# CORREO_DOMINIO=notificaciones.ejemplo.cl
#   CORREO_REMITENTE: remitente visible. Default "Citia <recordatorios@CORREO_DOMINIO>"
#   si hay CORREO_DOMINIO; si no, el remitente de pruebas de Resend (solo escribe a la
#   casilla de la cuenta).
# CORREO_REMITENTE=Citia <onboarding@resend.dev>
#   Topes del plan de Resend (Free: 100 al dia, 3000 al mes) y aviso al 80 %.
# RESEND_CUOTA_DIARIA=100
# RESEND_CUOTA_MENSUAL=3000
# CUOTA_UMBRAL_AVISO=0.8

# Recordatorios (ADR-13 §3, §5, §7, §11, §15, §16)
#   Configuracion predeterminada: minutos antes de la cita (1 a 3, entre 30 y 10080).
# RECORDATORIO_ANTELACIONES_MIN=1440,120
#   Horas sin envio, en la zona de la clinica (HH:mm).
# RECORDATORIO_SILENCIO_DESDE=21:00
# RECORDATORIO_SILENCIO_HASTA=08:00
#   El ultimo recordatorio vence este tiempo antes de la cita; umbral del tardio.
# RECORDATORIO_MARGEN_MINIMO_MIN=30
# RECORDATORIO_ANTELACION_MINIMA_TARDIA_MIN=60
#   Job de envio: reintentos por errores transitorios, lote y cadencia.
# RECORDATORIO_MAX_INTENTOS=5
# RECORDATORIO_LOTE=20
# RECORDATORIO_INTERVALO_SEG=60
#   Fusible por organizacion (envios al dia).
# RECORDATORIO_MAX_DIARIO_POR_TENANT=40
#   Politica de consentimiento (DT-16): apagada por decision del 2026-09-30.
# RECORDATORIO_EXIGIR_CONSENTIMIENTO=false
#   Alerta de tasa de fallo: sobre 5 % con al menos 20 casos en 24 h.
# RECORDATORIO_UMBRAL_TASA_FALLO=0.05
# RECORDATORIO_UMBRAL_MUESTRA_MIN=20
