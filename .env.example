PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=citia_dev

# Autenticacion JWT
#   JWT_SECRET: clave para firmar/verificar los tokens.
#   EN PRODUCCION debe inyectarse por el entorno (compose/secretos), NUNCA hardcodeada.
JWT_SECRET=dev-only-change-me-super-secret
#   JWT_EXPIRES_IN: tiempo de vida del token (formato de 'ms'/jsonwebtoken). Default 1d.
JWT_EXPIRES_IN=1d

# Frontend permitido por CORS (credentials habilitado).
FRONTEND_URL=http://localhost:5173

# Zona horaria de la clinica. El "dia" y la "hora" del dashboard de citas se
# calculan en esta zona (el contenedor corre en UTC). Default: America/Santiago.
APP_TZ=America/Santiago

# Test database (solo para integration tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASS=postgres
TEST_DB_NAME=citia_test
