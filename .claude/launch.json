{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "citia-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../citia-frontend", "run", "dev"],
      "port": 3002
    },
    {
      "name": "citia-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"],
      "port": 3000,
      "env": { "FRONTEND_URL": "http://localhost:3002" }
    }
  ]
}
